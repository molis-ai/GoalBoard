{
  "name": "@adeptify/goalboard",
  "version": "0.1.14",
  "description": "GoalBoard V1：面向人和 AI Runtime 的本地 SQLite 目标真相源",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeptify/goalboard.git"
  },
  "homepage": "https://github.com/adeptify/goalboard#readme",
  "bugs": {
    "url": "https://github.com/adeptify/goalboard/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "goalboard": "./dist/cli/main.js",
    "goalboard-mcp": "./dist/mcp/server.js",
    "goalboard-web": "./dist/web/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "skills",
    "examples/seed-demo.mts",
    "examples/draft-goal.json",
    "examples/leaf-goal.json",
    "README.md",
    "README.zh.md",
    "PRODUCT.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm build:migrated-packages && pnpm clean && tsc -p tsconfig.json && pnpm build:pty-client && node apps/local-host/tooling/write-build-manifest.mjs .",
    "build:migrated-packages": "pnpm -r --filter './apps/**' --filter './packages/**' --filter './modules/**' --filter './horizontal/**' --filter './plugins/**' --filter './tooling/plugin-cli' run build",
    "boundary:check": "pnpm --filter @adeptify/goalboard-test-kit build && node scripts/check-package-boundaries.mjs",
    "boundary:test": "pnpm --filter @adeptify/goalboard-test-kit test",
    "build:all": "pnpm build && pnpm boundary:check && pnpm workspace:build",
    "build:pty-client": "esbuild apps/workbench/src/terminal-client.ts --bundle --format=iife --platform=browser --outfile=dist/web/pty-client.js --loader:.css=text",
    "typecheck": "pnpm build:migrated-packages && tsc --noEmit -p tsconfig.json",
    "typecheck:all": "pnpm typecheck && pnpm boundary:check && pnpm workspace:typecheck",
    "test": "pnpm build && node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "workspace:build": "pnpm workspace:clean && pnpm -r --filter './apps/**' --filter './packages/**' --filter './modules/**' --filter './horizontal/**' --filter './plugins/**' --filter './tooling/plugin-cli' run build",
    "workspace:check": "node scripts/workspace-packages.mjs",
    "workspace:clean": "pnpm -r --filter './apps/**' --filter './packages/**' --filter './modules/**' --filter './horizontal/**' --filter './plugins/**' --filter './tooling/plugin-cli' run clean",
    "workspace:typecheck": "pnpm -r --filter './apps/**' --filter './packages/**' --filter './modules/**' --filter './horizontal/**' --filter './plugins/**' --filter './tooling/plugin-cli' run typecheck",
    "workspace:verify": "pnpm boundary:test && pnpm boundary:check && pnpm workspace:typecheck && pnpm workspace:build",
    "prepack": "node -e \"console.error('Use pnpm package:npm to build a standalone distribution from this workspace.'); process.exit(1)\"",
    "package:npm": "pnpm build && node apps/local-host/tooling/pack-npm.mjs",
    "install:local": "pnpm build && node dist/cli/main.js install --source .",
    "cli": "tsx src/cli/main.ts",
    "mcp": "tsx src/mcp/server.ts",
    "web": "tsx src/web/server.ts",
    "desktop": "cargo run --manifest-path desktop/src-tauri/Cargo.toml",
    "desktop:build:macos": "bash apps/desktop/tooling/build-macos-release.sh",
    "desktop:install:macos": "bash apps/desktop/tooling/install-macos-app.sh",
    "desktop:start:macos": "bash apps/desktop/tooling/start-macos-app.sh",
    "goalboard": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "@adeptify/goalboard-app-desktop": "workspace:*",
    "@adeptify/goalboard-app-local-host": "workspace:*",
    "@adeptify/goalboard-app-cli": "workspace:*",
    "@adeptify/goalboard-app-mcp": "workspace:*",
    "@adeptify/goalboard-contracts": "workspace:*",
    "@adeptify/goalboard-design-system": "workspace:*",
    "@adeptify/goalboard-app-workbench": "workspace:*",
    "@adeptify/goalboard-integration-github": "workspace:*",
    "@adeptify/goalboard-integration-gmail": "workspace:*",
    "@adeptify/goalboard-kernel": "workspace:*",
    "@adeptify/goalboard-module-artifacts": "workspace:*",
    "@adeptify/goalboard-module-context-ledger": "workspace:*",
    "@adeptify/goalboard-module-attention-resumption": "workspace:*",
    "@adeptify/goalboard-module-evidence-verification": "workspace:*",
    "@adeptify/goalboard-module-feed": "workspace:*",
    "@adeptify/goalboard-module-execution": "workspace:*",
    "@adeptify/goalboard-module-governance-collaboration": "workspace:*",
    "@adeptify/goalboard-module-goals": "workspace:*",
    "@adeptify/goalboard-module-projects": "workspace:*",
    "@adeptify/goalboard-module-private-work-context": "workspace:*",
    "@adeptify/goalboard-module-signals": "workspace:*",
    "@adeptify/goalboard-module-sources": "workspace:*",
    "@adeptify/goalboard-plugin-feed": "workspace:*",
    "@adeptify/goalboard-plugin-artifacts": "workspace:*",
    "@adeptify/goalboard-plugin-goals": "workspace:*",
    "@adeptify/goalboard-plugin-runtime": "workspace:*",
    "@adeptify/goalboard-plugin-cli": "workspace:*",
    "@adeptify/goalboard-service-connector-host": "workspace:*",
    "@adeptify/goalboard-service-listener-host": "workspace:*",
    "@adeptify/goalboard-service-runtime-host": "workspace:*",
    "@adeptify/goalboard-ui-host": "workspace:*",
    "@adeptify/intelligence-client": "file:vendor/intelligence-client/adeptify-intelligence-client-0.2.2.tgz",
    "@adeptify/search-evidence-layer": "file:vendor/search-evidence-layer/adeptify-search-evidence-layer-0.4.1.tgz",
    "better-sqlite3": "12.8.0",
    "lucide": "^1.31.0",
    "marked": "^18.0.11",
    "node-pty": "^1.1.0",
    "sanitize-html": "^2.17.7",
    "ws": "^8.21.3",
    "@adeptify/goalboard-plugin-work": "workspace:*"
  },
  "devDependencies": {
    "@adeptify/goalboard-test-kit": "workspace:*",
    "@tauri-apps/cli": "2.11.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
